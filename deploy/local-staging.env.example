# Local staging topology only. Copy to deploy/local-staging.env through
# scripts/unix/local-staging.sh or scripts/windows/local-staging.ps1; never
# place secrets in this file.

COMPASS_LOCAL_STAGING=True
COMPASS_LOCAL_STAGING_ACKNOWLEDGED=True
COMPASS_ACCESS_MODE=health_only
COMPASS_IMAGE_REF=localhost/compass:local-staging
COMPASS_RELEASE_VERSION=local-staging-dev
COMPASS_BUILD_ID=local-staging-dev
COMPASS_LOCAL_STAGING_PORT=8443
COMPASS_HEALTHCHECK_URL=https://localhost:8443/health/
COMPASS_READINESS_PROBE_EXTERNAL=True
COMPASS_READINESS_SYSTEM_IDENTITY=
COMPASS_ALLOW_DEMO_SEEDING=True

POSTGRES_DB=compass_local_staging
POSTGRES_USER=compass
ALLOWED_HOSTS=localhost,127.0.0.1,web,proxy
CSRF_TRUSTED_ORIGINS=https://localhost:3000,https://localhost:3100,https://localhost:8443
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:3100
CORS_ALLOW_CREDENTIALS=False
COMPASS_API_BASE_URL=https://localhost:8443
COMPASS_CLIENT_BASE_URL=https://localhost:3100
CACHE_URL=redis://redis:6379/0
TRUSTED_PROXY_HOPS=1
KEY_SOURCE_PROVIDER=podman_secret
KEY_SOURCE_PODMAN_SECRETS_DIR=/run/secrets

PROTECTED_STORAGE_BACKEND=s3
PROTECTED_STORAGE_S3_ENDPOINT_URL=http://minio:9000
PROTECTED_STORAGE_S3_BUCKET_NAME=compass-private-local-staging
PROTECTED_STORAGE_S3_USE_SSL=False
PROTECTED_STORAGE_S3_REGION_NAME=us-east-1
PROTECTED_STORAGE_S3_ADDRESSING_STYLE=path
BACKUP_STORAGE_BACKEND=s3_compatible
BACKUP_STORAGE_S3_ENDPOINT_URL=http://minio:9000
BACKUP_STORAGE_S3_BUCKET=compass-backups-local-staging
BACKUP_STORAGE_S3_USE_SSL=False
BACKUP_STORAGE_S3_REGION_NAME=us-east-1
BACKUP_STORAGE_S3_ADDRESSING_STYLE=path
BACKUP_LOCAL_DEMO_ROOT=/var/lib/compass-backup-work
BACKUP_RESTORE_EXECUTION_MODE=dry_run_only
BACKUP_ARCHIVE_MAX_BYTES=4294967296
BACKUP_LEGACY_FERNET_MAX_BYTES=67108864

ACCOUNT_SECURITY_CAPTCHA_ADAPTER=apps.account_security.captcha.CloudflareTurnstileAdapter
ACCOUNT_SECURITY_CAPTCHA_PROVIDER=turnstile
ACCOUNT_SECURITY_TURNSTILE_SITE_KEY=1x00000000000000000000AA
ACCOUNT_SECURITY_TURNSTILE_HOSTNAMES=localhost
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=noreply@local.invalid
COMPASS_EMAIL_REPLY_TO=reply-to@local.invalid
COMPASS_EMAIL_VERIFIED_SENDER_DOMAIN=local.invalid

# Set to DAILY only after the secure bootstrap imports the provider key.
COMPASS_LOCAL_STAGING_DAILY_ENABLED=False
ECOUNSELING_PROVIDER=disabled
ECOUNSELING_PROVIDER_MODE=DAILY_CLOUD
ECOUNSELING_DAILY_DOMAIN=demo-compass.daily.co
ECOUNSELING_DAILY_WEBHOOK_ID=
# A real Daily webhook requires a separately authorized public HTTPS tunnel.
ECOUNSELING_DAILY_WEBHOOK_URL=
ECOUNSELING_ROOM_PREFIX=compass-local-ecs
ECOUNSELING_REQUIRE_PROVIDER_AUTH_IN_PRODUCTION=True
ECOUNSELING_UNSAFE_PROVIDER_MODE_ACKNOWLEDGED=False

COMPASS_ONBOARDING_CATALOG_VERSION=local-staging-v1
COMPASS_ONBOARDING_ALLOW_DEMO_CATALOG=True

# Deployment-owned technical runtime controls.
MAINTENANCE_ENFORCEMENT_ENABLED=False
DOCUMENT_PDF_RENDERER_ENABLED=False
DOCUMENT_PDF_RENDERER_TIMEOUT_MS=30000
ACCOUNT_SECURITY_CAPTCHA_TIMEOUT_SECONDS=5
EMAIL_TIMEOUT=10
# The stack declares a supervised notification-worker service. Keep its
# runtime gate enabled; set False only when intentionally pausing delivery.
NOTIFICATION_WORKER_ENABLED=True
NOTIFICATION_WORKER_INTERVAL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LOCK_TIMEOUT_SECONDS=300
BACKUP_WORKER_POLL_INTERVAL_SECONDS=15
REPORT_SYNC_MAX_OUTPUT_BYTES=262144
REPORT_SYNC_MAX_WORK_UNITS=1000
REPORT_ASYNC_AFTER_WORK_UNITS=3000
REPORT_RUN_TIMEOUT_SECONDS=60
REPORT_EXPORT_MAX_OUTPUT_BYTES=8388608
PROTECTED_STORAGE_MAX_FILE_SIZE_BYTES=10485760
