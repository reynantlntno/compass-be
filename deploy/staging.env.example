# Copy outside the repository as deploy/staging.env and keep it root-only.
# This file contains non-secret topology/configuration values. Runtime secret
# values are retrieved from OCI Vault and created as external root-owned
# Podman secrets by deploy/bootstrap_vault_podman_secrets.sh.

COMPASS_SECRET_PREFIX=compass-staging
COMPASS_DATA_ROOT=/srv/compass/data
COMPASS_ACCESS_MODE=health_only
COMPASS_IMAGE_REF=localhost/compass:staging-amd64
DEBUG=False
TRUSTED_PROXY_HOPS=1
KEY_SOURCE_PROVIDER=podman_secret
KEY_SOURCE_PODMAN_SECRETS_DIR=/run/secrets

# Daily.co join authentication is enabled after the Vault-backed credentials
# below are bootstrapped. Join, recording, and worker controls are resolved
# from the active Governance/Policy Center records, never from deployment env.
ECOUNSELING_PROVIDER=DAILY
ECOUNSELING_PROVIDER_MODE=DAILY_CLOUD
ECOUNSELING_DAILY_DOMAIN=
ECOUNSELING_DAILY_WEBHOOK_ID=
ECOUNSELING_DAILY_WEBHOOK_URL=https://staging-api.compass-gco.com/counseling/internal/e-counseling/recording-callback/
ECOUNSELING_ROOM_PREFIX=compass-ecs
ECOUNSELING_REQUIRE_PROVIDER_AUTH_IN_PRODUCTION=True
ECOUNSELING_UNSAFE_PROVIDER_MODE_ACKNOWLEDGED=False

# ECOUNSELING_DAILY_API_KEY, ECOUNSELING_DAILY_WEBHOOK_SECRET, and
# ECOUNSELING_ROOM_SALT are retrieved from OCI Vault into root-owned Podman
# secrets. They must not be placed in this file.

# The bootstrap map must also provide these secret targets:
# POSTGRES_PASSWORD, SECRET_KEY, AUDIT_HASH_SECRET,
# ACCOUNT_SECURITY_HASH_SECRET, ACCOUNT_ACTIVATION_TOKEN_SECRET, DATABASE_URL,
# PROTECTED_STORAGE_S3_ACCESS_KEY, PROTECTED_STORAGE_S3_SECRET_KEY,
# BACKUP_STORAGE_S3_ACCESS_KEY, BACKUP_STORAGE_S3_SECRET_KEY,
# FIELD_ENCRYPTION_KEY, ACCOUNT_SECURITY_TURNSTILE_SECRET, EMAIL_HOST_PASSWORD.
# The password inside DATABASE_URL must match POSTGRES_PASSWORD.
# The runtime wrapper rejects blank, malformed, or reused core secrets.

POSTGRES_DB=compass
POSTGRES_USER=compass

ALLOWED_HOSTS=staging-api.compass-gco.com
CORS_ALLOWED_ORIGINS=https://staging.compass-gco.com
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=https://staging.compass-gco.com,https://staging-api.compass-gco.com
COMPASS_API_BASE_URL=https://staging-api.compass-gco.com
COMPASS_CLIENT_BASE_URL=https://staging.compass-gco.com
CACHE_URL=redis://redis:6379/0

# Optional non-secret defense persona inbox overrides. Configure these only in
# the root-owned /etc/compass/staging.env when an authorized staging seed is
# requested; do not commit real addresses here.
COMPASS_DEMO_IT_ADMIN_EMAIL=
COMPASS_DEMO_HEAD_GUIDANCE_EMAIL=
COMPASS_DEMO_COUNSELOR_EMAIL=
COMPASS_DEMO_GCO_STAFF_EMAIL=
COMPASS_DEMO_STUDENT_EMAIL=

# Immutable release identity; populate both from the approved artifact before
# starting the stack. The application rejects blank or placeholder values.
COMPASS_RELEASE_VERSION=
COMPASS_BUILD_ID=

# OCI Object Storage S3-compatible endpoint. The namespace is tenancy-specific
# and is not a credential.
PROTECTED_STORAGE_S3_ENDPOINT_URL=https://axhpojfzy4cq.compat.objectstorage.ap-singapore-1.oraclecloud.com
PROTECTED_STORAGE_S3_BUCKET_NAME=compass-private-staging
PROTECTED_STORAGE_BACKEND=s3
PROTECTED_STORAGE_S3_USE_SSL=True
PROTECTED_STORAGE_S3_ADDRESSING_STYLE=path
PROTECTED_STORAGE_S3_REGION_NAME=ap-singapore-1
BACKUP_STORAGE_S3_ENDPOINT_URL=https://axhpojfzy4cq.compat.objectstorage.ap-singapore-1.oraclecloud.com
BACKUP_STORAGE_S3_BUCKET=compass-backups-staging
BACKUP_STORAGE_BACKEND=s3_compatible
BACKUP_STORAGE_S3_USE_SSL=True
BACKUP_STORAGE_S3_ADDRESSING_STYLE=path
BACKUP_STORAGE_S3_REGION_NAME=ap-singapore-1


COMPASS_STAGING_PORT=8080
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT_SECONDS=60
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Cloudflare Turnstile is provisioned for the exact staging hostname. The
# site key is public; the secret is retrieved from OCI Vault into a Podman
# secret and must not be added here.
ACCOUNT_SECURITY_TURNSTILE_SITE_KEY=0x4AAAAAAESEzWJ0-yjl0Pjs
ACCOUNT_SECURITY_TURNSTILE_HOSTNAMES=staging.compass-gco.com
ACCOUNT_SECURITY_CAPTCHA_ADAPTER=apps.account_security.captcha.CloudflareTurnstileAdapter
ACCOUNT_SECURITY_CAPTCHA_PROVIDER=turnstile

# OCI Email Delivery is configured for staging activation. The SMTP password
# remains in OCI Vault; only the non-secret username is placed here.
EMAIL_HOST=smtp.email.ap-singapore-1.oci.oraclecloud.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Populate on the VM with the username returned by the OCI SMTP credential.
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=noreply@mail.compass-gco.com
# Temporary staging reply-to; replace with a monitored mailbox before real use.
COMPASS_EMAIL_REPLY_TO=noreply@mail.compass-gco.com
COMPASS_EMAIL_VERIFIED_SENDER_DOMAIN=mail.compass-gco.com

# Deployment-owned technical runtime controls. These values are injected into
# web and worker services and take effect on process restart.
MAINTENANCE_ENFORCEMENT_ENABLED=False
DOCUMENT_PDF_RENDERER_ENABLED=False
DOCUMENT_PDF_RENDERER_TIMEOUT_MS=30000
ACCOUNT_SECURITY_CAPTCHA_TIMEOUT_SECONDS=5
EMAIL_TIMEOUT=10
NOTIFICATION_WORKER_ENABLED=False
NOTIFICATION_WORKER_INTERVAL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LOCK_TIMEOUT_SECONDS=300
BACKUP_WORKER_POLL_INTERVAL_SECONDS=15
REPORT_SYNC_MAX_OUTPUT_BYTES=262144
REPORT_SYNC_MAX_WORK_UNITS=1000
REPORT_ASYNC_AFTER_WORK_UNITS=3000
REPORT_RUN_TIMEOUT_SECONDS=60
REPORT_EXPORT_MAX_OUTPUT_BYTES=8388608
PROTECTED_STORAGE_MAX_FILE_SIZE_BYTES=10485760
