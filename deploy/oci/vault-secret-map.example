# Copy outside the repository to /etc/compass/vault-secret-map and replace
# every placeholder with the OCID of an OCI Vault secret. Secret values never
# belong in this file.
POSTGRES_PASSWORD=ocid1.vaultsecret.oc1.ap-singapore-1.<postgres-password-secret>
SECRET_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<django-secret-key-secret>
AUDIT_HASH_SECRET=ocid1.vaultsecret.oc1.ap-singapore-1.<audit-hash-secret>
ACCOUNT_SECURITY_HASH_SECRET=ocid1.vaultsecret.oc1.ap-singapore-1.<account-security-hash-secret>
ACCOUNT_ACTIVATION_TOKEN_SECRET=ocid1.vaultsecret.oc1.ap-singapore-1.<account-activation-secret>
DATABASE_URL=ocid1.vaultsecret.oc1.ap-singapore-1.<database-url-secret>
PROTECTED_STORAGE_S3_ACCESS_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<protected-access-key-secret>
PROTECTED_STORAGE_S3_SECRET_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<protected-secret-key-secret>
BACKUP_STORAGE_S3_ACCESS_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<backup-access-key-secret>
BACKUP_STORAGE_S3_SECRET_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<backup-secret-key-secret>
FIELD_ENCRYPTION_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<field-encryption-key-secret>
ACCOUNT_SECURITY_TURNSTILE_SECRET=ocid1.vaultsecret.oc1.ap-singapore-1.<turnstile-secret>
EMAIL_HOST_PASSWORD=ocid1.vaultsecret.oc1.ap-singapore-1.<email-host-password-secret>
ECOUNSELING_DAILY_API_KEY=ocid1.vaultsecret.oc1.ap-singapore-1.<daily-api-key-secret>
ECOUNSELING_DAILY_WEBHOOK_SECRET=ocid1.vaultsecret.oc1.ap-singapore-1.<daily-webhook-secret>
ECOUNSELING_ROOM_SALT=ocid1.vaultsecret.oc1.ap-singapore-1.<ecounseling-room-salt-secret>
