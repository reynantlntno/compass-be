# COMPASS — Environment Variables
# Copy this file to .env and fill in values before starting.
# NEVER commit .env files — secrets must come from environment or Vault.

# Django
# Deployment secrets must be unique per purpose; do not reuse SECRET_KEY for
# audit, account-security, activation, field-encryption, or provider secrets.
SECRET_KEY=change-me-to-a-real-secret-key
# In production, use a long random secret distinct from SECRET_KEY for AUDIT_HASH_SECRET
AUDIT_HASH_SECRET=change-me-to-a-real-audit-hash-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development
COMPASS_ENVIRONMENT=development
COMPASS_ACCESS_MODE=active
CACHE_URL=redis://redis:6379/0
TRUSTED_PROXY_HOPS=0
# Explicit campus/private ranges used for coarse network classification
# (campus_network). Raw IPs and User-Agents are never persisted. Values are
# CIDR networks; institutional ranges are deployment-configured only, so keep
# this empty in the shared example.
CAMPUS_NETWORK_CIDRS=

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=compass
POSTGRES_USER=compass
POSTGRES_PASSWORD=<database-password-placeholder>

# Database URL (used by django-environ in settings). Its password must match
# POSTGRES_PASSWORD above; URL-encode reserved characters in the URL form.
DATABASE_URL=postgresql://compass:<database-password-placeholder>@db:5432/compass

# Student Activation
# In production, use a high-entropy cryptographically secure secret separate from SECRET_KEY
ACCOUNT_ACTIVATION_TOKEN_SECRET=change-me-to-a-real-activation-token-secret

# Secure E-Counseling / Daily.co
# Use safe placeholders only; do not commit provider keys, webhook secrets, or .env files.
ECOUNSELING_PROVIDER=DAILY
ECOUNSELING_PROVIDER_MODE=DAILY_CLOUD
ECOUNSELING_DAILY_API_KEY=
ECOUNSELING_DAILY_DOMAIN=
ECOUNSELING_DAILY_WEBHOOK_SECRET=
ECOUNSELING_DAILY_WEBHOOK_ID=
ECOUNSELING_DAILY_WEBHOOK_URL=
ECOUNSELING_ROOM_PREFIX=compass-ecs
ECOUNSELING_ROOM_SALT=change-me-to-a-random-room-salt
ECOUNSELING_REQUIRE_PROVIDER_AUTH_IN_PRODUCTION=True
ECOUNSELING_UNSAFE_PROVIDER_MODE_ACKNOWLEDGED=False

# Security & Private Storage Foundation
# Allowed values: local (test/dev) or s3 (MinIO/production)
PROTECTED_STORAGE_BACKEND=local
# Production local protected storage is blocked unless explicitly acknowledged.
COMPASS_ALLOW_LOCAL_PROTECTED_STORAGE_IN_PRODUCTION=False
PROTECTED_STORAGE_LOCAL_ROOT=./protected_media
# Protected-storage size is governed by a target-scoped Policy Center record.
# S3 compatible configuration (only if s3 backend is active)
PROTECTED_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
PROTECTED_STORAGE_S3_ACCESS_KEY=<minio-access-key-placeholder>
PROTECTED_STORAGE_S3_SECRET_KEY=<minio-secret-key-placeholder>
PROTECTED_STORAGE_S3_BUCKET_NAME=compass-private
PROTECTED_STORAGE_S3_USE_SSL=False
PROTECTED_STORAGE_S3_REGION_NAME=us-east-1
PROTECTED_STORAGE_S3_ADDRESSING_STYLE=path

# Assessment attachment limits and allowlists are managed through the Policy Center.

# Optional vetted system Chromium path. Leave blank to use Playwright-managed Chromium.
DOCUMENT_PDF_CHROMIUM_EXECUTABLE_PATH=

# Deployment-owned technical runtime controls. These are typed at startup;
# PolicyRecord rows are retained only as historical/deprecated records.
MAINTENANCE_ENFORCEMENT_ENABLED=False
DOCUMENT_PDF_RENDERER_ENABLED=False
DOCUMENT_PDF_RENDERER_TIMEOUT_MS=30000
ACCOUNT_SECURITY_CAPTCHA_TIMEOUT_SECONDS=5
EMAIL_TIMEOUT=10
# compose.override.yaml declares both supervised queue workers. Keep their
# runtime gates enabled in the development example; set them to False only
# when intentionally pausing local delivery or backup processing.
NOTIFICATION_WORKER_ENABLED=True
NOTIFICATION_WORKER_INTERVAL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LOCK_TIMEOUT_SECONDS=300
BACKUP_WORKER_POLL_INTERVAL_SECONDS=15
REPORT_SYNC_MAX_OUTPUT_BYTES=262144
REPORT_SYNC_MAX_WORK_UNITS=1000
REPORT_ASYNC_AFTER_WORK_UNITS=3000
REPORT_RUN_TIMEOUT_SECONDS=60
REPORT_EXPORT_MAX_OUTPUT_BYTES=8388608
PROTECTED_STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Key Source Settings
# Canonical application key-source provider. Allowed values: env, podman_secret.
# OCI Vault may bootstrap Podman secrets outside the application process.
KEY_SOURCE_PROVIDER=env
KEY_SOURCE_PODMAN_SECRETS_DIR=secrets
# Local development uses this value as the explicit Fernet key reference.
FIELD_ENCRYPTION_KEY=<explicit-development-fernet-key>
# New field keys resolve from each metadata row. Environment is test/dev only;
# production requires podman_secret and a separately provisioned mounted secret.
FIELD_ENCRYPTION_CHECKPOINT_DIR=/tmp/compass-field-encryption-checkpoints

# Disabled by default. Enabling requires deployment approval and an absolute,
# canonical UTC deadline in YYYY-MM-DDTHH:MM:SSZ form.
INVENTORY_ENCRYPTION_COMPATIBILITY_ENABLED=false
INVENTORY_ENCRYPTION_COMPATIBILITY_DEADLINE=
COUNSELING_ENCRYPTION_COMPATIBILITY_ENABLED=false
COUNSELING_ENCRYPTION_COMPATIBILITY_DEADLINE=
REFERRALS_ENCRYPTION_COMPATIBILITY_ENABLED=false
REFERRALS_ENCRYPTION_COMPATIBILITY_DEADLINE=
CALL_SLIPS_ENCRYPTION_COMPATIBILITY_ENABLED=false
CALL_SLIPS_ENCRYPTION_COMPATIBILITY_DEADLINE=

# Required for staging/production only. The deployment system injects these
# non-secret immutable artifact identifiers; never use a placeholder there.
COMPASS_RELEASE_VERSION=
COMPASS_BUILD_ID=

# Optional local-only defense persona inbox overrides. Keep real addresses in
# the ignored .env, not in the repository or staging example.
COMPASS_DEMO_IT_ADMIN_EMAIL=
COMPASS_DEMO_HEAD_GUIDANCE_EMAIL=
COMPASS_DEMO_COUNSELOR_EMAIL=
COMPASS_DEMO_GCO_STAFF_EMAIL=
COMPASS_DEMO_STUDENT_EMAIL=

# Notifications & Email Queue
COMPASS_API_BASE_URL=http://localhost:8000
COMPASS_HEALTHCHECK_URL=http://localhost:8000/health/
COMPASS_CLIENT_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@compass.edu.ph
COMPASS_EMAIL_REPLY_TO=reply-to@compass.edu.ph
COMPASS_EMAIL_VERIFIED_SENDER_DOMAIN=compass.edu.ph
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Account Security & Profile Settings Foundation
ACCOUNT_SECURITY_HASH_SECRET=change-me-to-a-real-account-security-hash-secret
# API token and assurance lifetimes are managed through the Policy Center.
ACCOUNT_SECURITY_CAPTCHA_ADAPTER=apps.account_security.captcha.FakeCaptchaAdapter
ACCOUNT_SECURITY_CAPTCHA_PROVIDER=fake
ACCOUNT_SECURITY_TURNSTILE_SITE_KEY=
ACCOUNT_SECURITY_TURNSTILE_SECRET=
ACCOUNT_SECURITY_TURNSTILE_HOSTNAMES=localhost
ACCOUNT_SECURITY_CACHE_ALIAS=default
ABUSE_CONTROL_CACHE_ALIAS=default
# Production requires an explicit canonical true value and refuses unsafe startup.
COMPASS_ONBOARDING_CATALOG_VERSION=
COMPASS_ONBOARDING_ALLOW_DEMO_CATALOG=True
CSP_ENABLED=False
CSP_SCRIPT_SRC=
CSP_FRAME_SRC=
# Student-import upload limits are managed through the Policy Center.

# Backup Storage and Retention Settings
BACKUP_STORAGE_BACKEND=metadata_only
BACKUP_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
BACKUP_STORAGE_S3_BUCKET=compass-backups
BACKUP_STORAGE_S3_ACCESS_KEY=<backup-s3-access-key-placeholder>
BACKUP_STORAGE_S3_SECRET_KEY=<backup-s3-secret-key-placeholder>
BACKUP_STORAGE_S3_USE_SSL=False
BACKUP_STORAGE_S3_REGION_NAME=us-east-1
BACKUP_STORAGE_S3_ADDRESSING_STYLE=path
BACKUP_LOCAL_DEMO_ROOT=./backups
BACKUP_RESTORE_EXECUTION_MODE=dry_run_only
BACKUP_WORKER_ENABLED=True
BACKUP_ARCHIVE_MAX_BYTES=4294967296
BACKUP_LEGACY_FERNET_MAX_BYTES=67108864
